generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum AdminRole {
  SUPER_ADMIN
  SALES
  FINANCE
  OPERATIONS
  CONTENT_EDITOR
  CHECKIN_STAFF
  VIEWER
}
enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}
enum Channel {
  EMAIL
  SMS
}
enum EnrollmentType {
  VISITOR
  CONFERENCE
  EXHIBITOR
}
enum EnrollmentStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  CONFIRMED
  REJECTED
  CANCELLED
}
enum BoothRequestStatus {
  NEW
  UNDER_REVIEW
  OFFERED
  ACCEPTED
  WAITING_INVOICE
  INVOICED
  ALLOCATION_PENDING
  CONFIRMED
  CANCELLED
  REJECTED
}
enum FloorplanStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum BoothUnitStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  BLOCKED
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}
enum PaymentRequestStatus {
  NEW
  REVIEWING
  INVOICED
  CANCELLED
}
enum TransferStatus {
  SUBMITTED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}
enum PassStatus {
  ACTIVE
  REVOKED
  EXPIRED
}
enum ScanResult {
  VALID_ACCEPTED
  ALREADY_CHECKED_IN
  WRONG_ZONE
  NOT_YET_VALID
  EXPIRED
  REVOKED
  UNPAID
  INVALID
  OFFLINE_ERROR
}
model Event {
  id String @id @default(uuid())
  code String @unique
  title String
  venue String
  startsAt DateTime
  endsAt DateTime
  timezone String @default("Asia/Jakarta")
  visitorOpen Boolean @default(false)
  published Boolean @default(false)
  createdAt DateTime @default(now())
  conferences Conference[]
  enrollments Enrollment[]
  floorplans Floorplan[]
  boothRequests BoothRequest[]
  passes EventPass[]
}
model Conference {
  id String @id @default(uuid())
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  title String
  slug String
  published Boolean @default(false)
  feeMinor BigInt?
  currency String @default("IDR")
  capacity Int?
  startsAt DateTime?
  enrollments Enrollment[]
  @@unique([eventId,slug])
}
model CustomerAccount {
  id String @id @default(uuid())
  email String? @unique
  phone String? @unique
  status AccountStatus @default(PENDING_VERIFICATION)
  verifiedEmailAt DateTime?
  verifiedPhoneAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile CustomerProfile?
  challenges OtpChallenge[]
  sessions CustomerSession[]
  enrollments Enrollment[]
  requests BoothRequest[]
  invoices Invoice[]
  paymentRequests ManualPaymentRequest[]
  passes EventPass[]
}
model CustomerProfile {
  id String @id @default(uuid())
  accountId String @unique
  account CustomerAccount @relation(fields:[accountId],references:[id])
  fullName String
  organization String?
  jobTitle String?
  country String?
  consentVersion String
  consentAt DateTime
  updatedAt DateTime @updatedAt
  notifyChannel String @default("EMAIL")
}
model OtpChallenge {
  id String @id @default(uuid())
  accountId String
  account CustomerAccount @relation(fields:[accountId],references:[id])
  channel Channel
  destinationHash String
  codeHash String
  attemptCount Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  purpose String @default("LOGIN")
  newDestination String?
  ipHash String?
  @@index([accountId,createdAt])
  @@index([ipHash,createdAt])
}
model CustomerSession {
  id String @id @default(uuid())
  accountId String
  account CustomerAccount @relation(fields:[accountId],references:[id])
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}
model AdminUser {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  role AdminRole
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions AdminSession[]
}
model AdminSession {
  id String @id @default(uuid())
  adminId String
  admin AdminUser @relation(fields:[adminId],references:[id])
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Enrollment {
  id String @id @default(uuid())
  accountId String
  account CustomerAccount @relation(fields:[accountId],references:[id])
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  conferenceId String?
  conference Conference? @relation(fields:[conferenceId],references:[id])
  type EnrollmentType
  status EnrollmentStatus @default(SUBMITTED)
  profileSnapshot Json
  consentAt DateTime
  createdAt DateTime @default(now())
  confirmedAt DateTime?
  passes EventPass[]
  invoices Invoice[]
  paymentRequests ManualPaymentRequest[]
  @@index([accountId,eventId,type])
}
model Floorplan {
  id String @id @default(uuid())
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  versionNo Int
  title String
  backgroundUrl String?
  canvasWidth Int @default(1200)
  canvasHeight Int @default(800)
  status FloorplanStatus @default(DRAFT)
  rowVersion Int @default(1)
  publishedAt DateTime?
  backgroundAlt String?
  backgroundRights String?
  units BoothUnit[]
  boothRequests BoothRequest[]
  @@unique([eventId,versionNo])
}
model BoothUnit {
  id String @id @default(uuid())
  floorplanId String
  floorplan Floorplan @relation(fields:[floorplanId],references:[id])
  code String
  category String
  hall String?
  zone String?
  x Float
  y Float
  w Float
  h Float
  areaSqm Decimal @db.Decimal(10,1)
  status BoothUnitStatus @default(AVAILABLE)
  approvedPublicName String?
  categoryId String?
  boothCategory BoothCategory? @relation(fields:[categoryId],references:[id])
  lengthM Decimal? @db.Decimal(10,1)
  widthM Decimal? @db.Decimal(10,1)
  dimensionLabel String?
  rotation Int @default(0)
  internalNotes String?
  placed Boolean @default(true)
  assignments BoothAssignment[]
  holds BoothHold[]
  @@unique([floorplanId,code])
  @@index([status])
}
model BoothCategory {
  id String @id @default(uuid())
  eventId String
  name String
  colorHex String
  pattern String @default("SOLID")
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  units BoothUnit[]
  @@unique([eventId,name])
}
model BoothRequest {
  id String @id @default(uuid())
  accountId String
  account CustomerAccount @relation(fields:[accountId],references:[id])
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  floorplanId String
  floorplan Floorplan @relation(fields:[floorplanId],references:[id])
  requestedAreaSqm Decimal @db.Decimal(10,1)
  preferredUnitIds Json
  companySnapshot Json
  notes String?
  status BoothRequestStatus @default(NEW)
  offeredAreaSqm Decimal? @db.Decimal(10,1)
  originalFloorplanId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignments BoothAssignment[]
  invoices Invoice[]
  paymentRequests ManualPaymentRequest[]
  offers BoothOffer[]
  holds BoothHold[]
  @@index([accountId,createdAt])
}
model BoothOffer {
  id String @id @default(uuid())
  boothRequestId String
  boothRequest BoothRequest @relation(fields:[boothRequestId],references:[id])
  revision Int
  floorplanVersionNo Int
  offeredUnitIds Json
  offeredUnits Json
  offeredAreaSqm Decimal @db.Decimal(10,1)
  quotedPriceMinor BigInt
  currency String @default("IDR")
  notes String?
  expiresAt DateTime?
  acceptedAt DateTime?
  offeredBy String
  createdAt DateTime @default(now())
  @@unique([boothRequestId,revision])
  @@index([boothRequestId,createdAt])
}
model BoothAssignment {
  id String @id @default(uuid())
  boothUnitId String
  boothUnit BoothUnit @relation(fields:[boothUnitId],references:[id])
  boothRequestId String
  boothRequest BoothRequest @relation(fields:[boothRequestId],references:[id])
  active Boolean @default(true)
  assignedAt DateTime @default(now())
  endedAt DateTime?
  assignedBy String
  approvedForPublic Boolean @default(false)
  @@index([boothUnitId,active])
}
model BoothHold {
  id String @id @default(uuid())
  boothUnitId String
  boothUnit BoothUnit @relation(fields:[boothUnitId],references:[id])
  boothRequestId String
  boothRequest BoothRequest @relation(fields:[boothRequestId],references:[id])
  status String @default("ACTIVE")
  createdBy String
  createdAt DateTime @default(now())
  expiresAt DateTime
  endedAt DateTime?
  endedBy String?
  endReason String?
  @@index([status,expiresAt])
  @@index([boothRequestId,status])
}
model ManualPaymentRequest {
  id String @id @default(uuid())
  accountId String
  account CustomerAccount @relation(fields:[accountId],references:[id])
  enrollmentId String?
  enrollment Enrollment? @relation(fields:[enrollmentId],references:[id])
  boothRequestId String?
  boothRequest BoothRequest? @relation(fields:[boothRequestId],references:[id])
  status PaymentRequestStatus @default(NEW)
  createdAt DateTime @default(now())
}
model Invoice {
  id String @id @default(uuid())
  number String @unique
  accountId String
  account CustomerAccount @relation(fields:[accountId],references:[id])
  enrollmentId String?
  enrollment Enrollment? @relation(fields:[enrollmentId],references:[id])
  boothRequestId String?
  boothRequest BoothRequest? @relation(fields:[boothRequestId],references:[id])
  status InvoiceStatus @default(DRAFT)
  currency String @default("IDR")
  totalMinor BigInt
  minimumDpMinor BigInt @default(0)
  dueAt DateTime?
  issuedAt DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now())
  items InvoiceItem[]
  transfers ManualTransfer[]
  adjustments PaymentAdjustment[]
  deliveries InvoiceDelivery[]
  cancelledAt DateTime?
  cancelReason String?
  revisionOfId String?
}
model InvoiceItem {
  id String @id @default(uuid())
  invoiceId String
  invoice Invoice @relation(fields:[invoiceId],references:[id])
  description String
  quantity Int @default(1)
  unitPriceMinor BigInt
  amountMinor BigInt
}
model ManualTransfer {
  id String @id @default(uuid())
  invoiceId String
  invoice Invoice @relation(fields:[invoiceId],references:[id])
  amountMinor BigInt
  bankReference String?
  proofUrl String?
  status TransferStatus @default(SUBMITTED)
  transferredAt DateTime?
  verifiedAt DateTime?
  verifiedBy String?
  createdAt DateTime @default(now())
  source String @default("FINANCE")
  submittedBy String?
  submittedByAccountId String?
  payerName String?
  decisionReason String?
  approvalRequired Boolean @default(false)
  @@index([invoiceId,status])
  @@index([bankReference])
}
model PaymentAdjustment {
  id String @id @default(uuid())
  invoiceId String
  invoice Invoice @relation(fields:[invoiceId],references:[id])
  transferId String?
  type String
  amountMinor BigInt
  reason String
  approvedBy String
  createdAt DateTime @default(now())
  evidenceRef String?
  @@index([invoiceId])
}
model InvoiceDelivery {
  id String @id @default(uuid())
  invoiceId String
  invoice Invoice @relation(fields:[invoiceId],references:[id])
  channel String
  destinationMasked String
  status String
  outboxKey String? @unique
  sentBy String
  reason String
  createdAt DateTime @default(now())
  sentAt DateTime?
  @@index([invoiceId,createdAt])
}
model EventPass {
  id String @id @default(uuid())
  accountId String
  account CustomerAccount @relation(fields:[accountId],references:[id])
  enrollmentId String
  enrollment Enrollment @relation(fields:[enrollmentId],references:[id])
  eventId String
  event Event @relation(fields:[eventId],references:[id])
  tokenHash String @unique
  encryptedToken String?
  status PassStatus @default(ACTIVE)
  entitlement String @default("EXPO_ENTRY")
  issuedAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokeReason String?
  replacedById String?
  shortCodeHash String? @unique
  scans PassScan[]
  admissions Admission[]
}
model Gate {
  id String @id @default(uuid())
  eventId String
  code String
  name String
  zones String[]
  active Boolean @default(true)
  createdAt DateTime @default(now())
  staff StaffGateAssignment[]
  @@unique([eventId,code])
}
model StaffGateAssignment {
  id String @id @default(uuid())
  adminId String
  gateId String
  gate Gate @relation(fields:[gateId],references:[id])
  createdBy String
  createdAt DateTime @default(now())
  @@unique([adminId,gateId])
}
model AdmissionPolicy {
  id String @id @default(uuid())
  eventId String
  zone String
  reentry String @default("ONCE_PER_DAY")
  updatedBy String
  updatedAt DateTime @updatedAt
  @@unique([eventId,zone])
}
model PassScan {
  id String @id @default(uuid())
  passId String?
  pass EventPass? @relation(fields:[passId],references:[id])
  gate String
  zone String
  result ScanResult
  scannedBy String
  createdAt DateTime @default(now())
  method String @default("CAMERA")
  @@index([createdAt])
  @@index([scannedBy,createdAt])
}
model Admission {
  id String @id @default(uuid())
  passId String
  pass EventPass @relation(fields:[passId],references:[id])
  zone String
  dayKey String
  gate String
  admittedBy String
  admittedAt DateTime @default(now())
  @@unique([passId,zone,dayKey])
}
model Notification {
  id String @id @default(uuid())
  audienceRole AdminRole
  type String
  recordType String
  recordId String
  readAt DateTime?
  createdAt DateTime @default(now())
}
model NotificationOutbox {
  id String @id @default(uuid())
  topic String
  dedupeKey String @unique
  payload Json
  state String @default("QUEUED")
  attempts Int @default(0)
  nextRunAt DateTime @default(now())
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(uuid())
  adminId String?
  accountId String?
  action String
  resourceType String
  resourceId String
  beforeState Json?
  afterState Json?
  createdAt DateTime @default(now())
  @@index([resourceType,resourceId,createdAt])
}
model Lead {
  id String @id @default(uuid())
  leadType String
  name String
  email String
  company String?
  phone String?
  message String
  consentVersion String
  consentAt DateTime
  utmSource String?
  utmMedium String?
  utmCampaign String?
  status String @default("NEW")
  ipHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,createdAt])
  @@index([ipHash,createdAt])
}
model ContentItem {
  id String @id @default(uuid())
  kind String
  locale String @default("en")
  title String
  slug String
  summary String?
  body String?
  url String?
  fileType String?
  fileSizeBytes Int?
  imageUrl String?
  altText String?
  rightsStatus String?
  role String?
  status String @default("DRAFT")
  sortOrder Int @default(0)
  publishedAt DateTime?
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([kind,locale,slug])
  @@index([kind,locale,status,sortOrder])
}
model WaitlistEntry {
  id String @id @default(uuid())
  conferenceId String
  accountId String
  status String @default("WAITING")
  createdAt DateTime @default(now())
  releasedAt DateTime?
  releasedBy String?
  enrollmentId String?
  @@unique([conferenceId,accountId])
  @@index([conferenceId,status,createdAt])
}
model AppSetting {
  key String @id
  value String
  updatedBy String
  updatedAt DateTime @updatedAt
}
model DataRequest {
  id String @id @default(uuid())
  accountId String
  kind String
  details String
  status String @default("RECEIVED")
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  @@index([status,createdAt])
}
model InternalNote {
  id String @id @default(uuid())
  resourceType String
  resourceId String
  body String
  adminId String
  createdAt DateTime @default(now())
  @@index([resourceType,resourceId,createdAt])
}
model ExportJob {
  id String @id @default(uuid())
  adminId String
  reportType String
  filters Json
  format String
  state String @default("QUEUED")
  objectKey String?
  rowCount Int @default(0)
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

model InvoiceSequence {
  key String @id
  nextNumber Int @default(1)
}
