# DATABASE_URL: use private managed PostgreSQL; never commit credentials.
DATABASE_URL=postgresql://user:password@localhost:5432/imdx_dev?schema=public
SESSION_KEY=replace-with-32-plus-random-characters
OTP_HASH_SECRET=replace-with-another-32-plus-random-characters
# Optional live delivery provider; do not enable auth until configured.
EMAIL_PROVIDER=disabled
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=disabled
# Set ADMIN_SEED_EMAIL / ADMIN_SEED_PASSWORD only in local shell when running admin:create.
PUBLIC_BASE_URL=http://localhost:3000
# Policy gates — default fail closed pending organizer approval
ENABLE_REGISTRATION=false
ENABLE_INVOICES=false
ENABLE_QR_ADMISSION=false
APPROVED_BANK_NAME=
APPROVED_BANK_ACCOUNT_NAME=
APPROVED_BANK_ACCOUNT_NUMBER=
