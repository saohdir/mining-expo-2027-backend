# Copy to .env.uat for UAT, NEVER commit secrets
DATABASE_URL=postgresql://user:password@localhost:5432/imdx_uat?schema=public
IMDX_DB_PASSWORD=STRONG_RANDOM_PASSWORD
SESSION_KEY=replace-with-32-plus-random-characters
OTP_HASH_SECRET=replace-with-another-32-plus-random-characters
QR_ENCRYPTION_KEY=replace-with-a-32-plus-character-high-entropy-key
PUBLIC_BASE_URL=https://YOUR-UAT-DOMAIN
ENABLE_REGISTRATION=false
ENABLE_INVOICES=false
ENABLE_QR_ADMISSION=false
# P1/P2 extensions (docs/P1_P2_EXTENSIONS.md) — keep off until the Product Owner approves.
ENABLE_EXHIBITOR_STAFF=false
EXHIBITOR_STAFF_LIMIT=5
ENABLE_GROUP_ENROLLMENT=false
ENABLE_BULK_TOOLS=false
ENABLE_FEE_ESTIMATOR=false
CONTENT_APPROVAL_REQUIRED=false
ACTIVE_EVENT_CODE=IMDX-2027
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_SYNC_ENTITIES=LEAD
ENABLE_MESSAGING_AUTOMATION=false
WHATSAPP_PROVIDER=disabled
ALLOW_BOOTH_ALLOCATION_ON_DP=false
EMAIL_PROVIDER=disabled
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
APPROVED_BANK_NAME=
APPROVED_BANK_ACCOUNT_NAME=
APPROVED_BANK_ACCOUNT_NUMBER=
FLOORPLAN_UPLOAD_DIR=./.data/floorplans
